# Copy to .env beside compose.yaml. Set permissions to 0600.
# Use URL-safe hex so Compose can insert the same password in the DSN unescaped.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Generate with: openssl rand -base64 32
# Keep this key with the database backups in a separate secure location.
APP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
PUBLIC_BASE_URL=https://REPLACE_WITH_PUBLIC_HOST

# Optional local diagnostic/health port. Public nginx uses a restricted socket.
# APP_PORT=8080
# If overridden, update the socket path in deploy/nginx.conf as well.
# PROXY_SOCKET_DIR=/var/lib/vanillapay-proxy
