{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "typeRoots": ["../web/node_modules/@types", "../web/node_modules"],
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@/*": ["../web/src/*"],
      "@playwright/test": ["../web/node_modules/@playwright/test", "../web/node_modules/@playwright/test/index.mjs"],
      "msw/node": ["../web/node_modules/msw/lib/node/index.d.ts"],
      "*": ["../web/node_modules/@types/*", "../web/node_modules/*"]
    }
  },
  "include": ["*.ts", "frontend/**/*.ts", "frontend/**/*.tsx", "e2e/**/*.ts", "../web/src/i18next.d.ts"]
}
